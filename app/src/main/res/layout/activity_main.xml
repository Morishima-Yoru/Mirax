<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mirax_background">

    <LinearLayout
        android:id="@+id/split"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/paneStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_menu"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_nav_menu" />

                <ImageButton
                    android:id="@+id/startBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_back"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_nav_back"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/startTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/mirax_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pageStart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:id="@+id/paneDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/mirax_stroke"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/paneEnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/mirax_pane"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/endBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/endBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_back"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_nav_back" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pageEnd"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@color/mirax_surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_menu"
                android:textColor="@color/mirax_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/drawerClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sidebar_close"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_close" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/drawerBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="40dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
